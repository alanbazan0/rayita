# Copia este archivo a .env.deploy y llénalo. .env.deploy NUNCA se sube al repo.
# Lo usan deploy.sh (despliegue manual) y deploy/set-github-secrets.sh (secretos de GitHub).

# --- FTP de HostGator (hostname real del servidor, NO el dominio) ---
FTP_SERVER=gator1234.hostgator.com
FTP_PORT=21
FTP_USER=usuario@alanbazan.com.mx
FTP_PASS=

# --- Carpetas, relativas al inicio del FTP (/public_html/projects/) ---
APP_DIR=rayita_app/
DEPLOY_DIR=rayita_deploy/

# --- URLs ---
# Web de pruebas (aquí vive deploy.php)
APP_URL=https://rayita.alanbazan.com.mx
# API (sin /api al final)
API_URL=https://api.rayita.alanbazan.com.mx

# --- Token de deploy.php: cadena larga y aleatoria (openssl rand -hex 32) ---
MIGRATE_TOKEN=

# --- .env de producción de la API ---
# Genera la clave con: cd backend && php artisan key:generate --show
APP_KEY=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=no-reply@alanbazan.com.mx
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@alanbazan.com.mx
# Código de invitación para registrarse (vacío = registro abierto)
INVITE_CODE=
